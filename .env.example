# Use a SEPARATE Telegram test bot token for development. Never the production token.
BOT_TOKEN=

# Your Telegram numeric user ID(s), comma-separated. Get yours from @userinfobot.
# Only these people can use /status, /results, /test, /setup and the membership commands.
ADMIN_USER_IDS=

# Group chat IDs to track joins/leaves, comma-separated (they start with -100...).
# The bot must be an ADMIN in each of these groups. Empty = tracking off.
TRACKED_CHAT_IDS=

# Which events send you a private alert: leave | join | join,leave  (default: leave)
# All events are saved either way; this only controls alerts.
MEMBERSHIP_ALERTS=leave

# Optional; defaults to membership_events.sqlite3 beside app.py.
MEMBERSHIP_DB_PATH=membership_events.sqlite3

# ---- Join request auto-approval ----
# Groups where the bot approves join requests (all 6 groups), comma-separated.
# Bot must be ADMIN there with "Add members / Invite users" permission. Empty = off.
APPROVAL_CHAT_IDS=

# The 2 landing groups: Announcements + Scholar Introduction.
# Landing groups: approved if the username is in the scholar list (Google Form CSV).
# Other groups: approved if the person is already in BOTH landing groups.
MANDATORY_CHAT_IDS=
